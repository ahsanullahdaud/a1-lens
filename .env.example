# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://a1lens:a1lens@localhost:5432/a1lens

# --- Crawler politeness -------------------------------------------------
# Identify yourself honestly. Add a contact so a site owner can reach you.
CRAWLER_USER_AGENT=A1LensBot/0.1 (personal learning project)
# Minimum gap between two requests to the same host, in milliseconds.
CRAWLER_DELAY_MS=2000

# --- Phase 2: eBay Browse API (optional) --------------------------------
# Free keys: https://developer.ebay.com/ -> create a Production keyset.
# Leave blank to skip the eBay source.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
